# === Obrigatórios ===
OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# === Opcionais (com default no código) ===

# Onde fica o banco SQLite e o índice vetorial
DATA_DIR=./data

# Modo seguro: true = não posta no WhatsApp, só loga o que postaria
DRY_RUN=true

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Modelos da OpenAI
EMBEDDING_MODEL=text-embedding-3-small
AGENT_MODEL=gpt-4o-mini
COPY_MODEL=gpt-4o-mini

# Cooldown por produto (ms) — não posta o mesmo produto 2x em menos de 24h
COOLDOWN_PRODUTO_MS=86400000

NODE_ENV=development
